{
  "$defs": {
    "ChartDoc": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "type": {
          "enum": [
            "kpi",
            "line",
            "area",
            "bar",
            "stacked_bar",
            "histogram",
            "scatter",
            "heatmap",
            "table",
            "pie",
            "treemap"
          ],
          "title": "Type",
          "type": "string"
        },
        "dataset_ref": {
          "discriminator": {
            "mapping": {
              "metric": "#/$defs/MetricRef",
              "result_handle": "#/$defs/ResultHandleRef",
              "verified_query": "#/$defs/VerifiedQueryRef"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ResultHandleRef"
            },
            {
              "$ref": "#/$defs/VerifiedQueryRef"
            },
            {
              "$ref": "#/$defs/MetricRef"
            }
          ],
          "title": "Dataset Ref"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/FieldDef"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "encoding": {
          "$ref": "#/$defs/Encoding"
        },
        "query": {
          "$ref": "#/$defs/QueryBinding"
        },
        "sensitivity": {
          "default": "internal",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ],
          "title": "Sensitivity",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "preview": {
          "additionalProperties": true,
          "title": "Preview",
          "type": "object"
        }
      },
      "required": [
        "id",
        "title",
        "type",
        "dataset_ref",
        "fields",
        "provenance"
      ],
      "title": "ChartDoc",
      "type": "object"
    },
    "Encoding": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Y",
          "type": "array"
        },
        "series": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "aggregation": {
          "default": "sum",
          "enum": [
            "sum",
            "avg",
            "min",
            "max",
            "count",
            "count_distinct",
            "none"
          ],
          "title": "Aggregation",
          "type": "string"
        }
      },
      "title": "Encoding",
      "type": "object"
    },
    "FieldDef": {
      "additionalProperties": false,
      "description": "One column of the bound dataset, as resolved when the chart was bound.",
      "properties": {
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "temporal",
            "quantitative",
            "nominal",
            "ordinal",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "sensitivity": {
          "default": "internal",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ],
          "title": "Sensitivity",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "FieldDef",
      "type": "object"
    },
    "FilterDoc": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "field": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "op": {
          "default": "eq",
          "enum": [
            "eq",
            "neq",
            "in",
            "not_in",
            "gt",
            "gte",
            "lt",
            "lte",
            "between"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "scope": {
          "items": {
            "type": "string"
          },
          "title": "Scope",
          "type": "array"
        },
        "resolved": {
          "additionalProperties": true,
          "title": "Resolved",
          "type": "object"
        }
      },
      "required": [
        "id",
        "field"
      ],
      "title": "FilterDoc",
      "type": "object"
    },
    "KpiDoc": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "metric": {
          "$ref": "#/$defs/MetricRef"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        },
        "sensitivity": {
          "default": "internal",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ],
          "title": "Sensitivity",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "metric",
        "provenance"
      ],
      "title": "KpiDoc",
      "type": "object"
    },
    "Layout": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "const": 12,
          "default": 12,
          "title": "Columns",
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/LayoutItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "title": "Layout",
      "type": "object"
    },
    "LayoutItem": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Ref",
          "type": "string"
        },
        "x": {
          "exclusiveMaximum": 12,
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        },
        "w": {
          "maximum": 12,
          "minimum": 1,
          "title": "W",
          "type": "integer"
        },
        "h": {
          "maximum": 48,
          "minimum": 1,
          "title": "H",
          "type": "integer"
        },
        "tab": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tab"
        }
      },
      "required": [
        "ref",
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "LayoutItem",
      "type": "object"
    },
    "MetricRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "metric",
          "default": "metric",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "dimensions": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Dimensions",
          "type": "array"
        },
        "sensitivity": {
          "default": "internal",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ],
          "title": "Sensitivity",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "MetricRef",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where the chart's numbers come from. Required: an unsourced chart is never valid.",
      "properties": {
        "sources": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "query_ids": {
          "items": {
            "type": "string"
          },
          "title": "Query Ids",
          "type": "array"
        },
        "created_by": {
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "created_via": {
          "default": "user",
          "enum": [
            "user",
            "conversation",
            "agent",
            "import"
          ],
          "title": "Created Via",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "turn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turn Id"
        }
      },
      "required": [
        "sources",
        "created_by"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "QueryBinding": {
      "additionalProperties": false,
      "description": "The chart's query version. `query.extend_period` raises the version and sets the comparison.",
      "properties": {
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "compare": {
          "default": "none",
          "enum": [
            "none",
            "yoy",
            "pop"
          ],
          "title": "Compare",
          "type": "string"
        },
        "period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        }
      },
      "title": "QueryBinding",
      "type": "object"
    },
    "ResultHandleRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "result_handle",
          "default": "result_handle",
          "title": "Kind",
          "type": "string"
        },
        "handle_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Handle Id",
          "type": "string"
        },
        "query_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Id"
        },
        "sensitivity": {
          "default": "internal",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ],
          "title": "Sensitivity",
          "type": "string"
        }
      },
      "required": [
        "handle_id"
      ],
      "title": "ResultHandleRef",
      "type": "object"
    },
    "Tab": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "Tab",
      "type": "object"
    },
    "TextBlock": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "markdown": {
          "default": "",
          "maxLength": 20000,
          "title": "Markdown",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "TextBlock",
      "type": "object"
    },
    "VerifiedQueryRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "verified_query",
          "default": "verified_query",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "sensitivity": {
          "default": "internal",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ],
          "title": "Sensitivity",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "VerifiedQueryRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "dashboard.v2",
      "default": "dashboard.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "audience": {
      "default": "operational",
      "enum": [
        "executive",
        "operational"
      ],
      "title": "Audience",
      "type": "string"
    },
    "layout": {
      "$ref": "#/$defs/Layout"
    },
    "tabs": {
      "items": {
        "$ref": "#/$defs/Tab"
      },
      "title": "Tabs",
      "type": "array"
    },
    "filters": {
      "items": {
        "$ref": "#/$defs/FilterDoc"
      },
      "title": "Filters",
      "type": "array"
    },
    "charts": {
      "items": {
        "$ref": "#/$defs/ChartDoc"
      },
      "maxItems": 60,
      "title": "Charts",
      "type": "array"
    },
    "text_blocks": {
      "items": {
        "$ref": "#/$defs/TextBlock"
      },
      "title": "Text Blocks",
      "type": "array"
    },
    "kpis": {
      "items": {
        "$ref": "#/$defs/KpiDoc"
      },
      "title": "Kpis",
      "type": "array"
    },
    "sensitivity": {
      "default": "internal",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "Sensitivity",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title"
  ],
  "title": "DashboardDoc",
  "type": "object"
}
